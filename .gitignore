# Game install: copyrighted assets + build output (not ours)
/Need For Speed II SE/

# Toolchain: ~1.3 GB of compilers/SDL; keep only the build script
/_toolchain/*
!/_toolchain/build.sh

# Upstream NFSIISE port: vendored separately; track only our additions
/NFSIISE-source/*
!/NFSIISE-source/src/
/NFSIISE-source/src/*
!/NFSIISE-source/src/mclaren_palette.c
!/NFSIISE-source/src/Asm/
/NFSIISE-source/src/Asm/*
!/NFSIISE-source/src/Asm/NFS2SE.asm

# Large archives / scratch drops
/Fix/
/Fix.zip
/*.rar
/_build/
/nfs2-modern/
/Readme.txt

# Build artifacts & backups
*.o
*.exe
*.map
*.mcbak
*.partbak
*.fzrbak
*.bonusbak
*.bak

# Python
__pycache__/
*.pyc
